# Copy to .env for local development. Placeholder values only; never put real secrets here.

# --- API (apps/api) ---
APP_ENV=local                  # local | test | dev | prod
AUTH_MODE=dev-header           # dev-header (local/test only) | cognito (TODO)
REPOSITORY_BACKEND=memory      # memory (local/test only) | postgres (needs DATABASE_URL)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL (docker compose --profile postgres up -d db) ---
# Apply migrations first: uv run python -m application.adapters.postgres
# DATABASE_URL=postgresql://builderwars:builderwars-local@localhost:5432/builderwars
# DATABASE_POOL_MAX_SIZE=5
# Disposable database for the PostgreSQL run of the test suite (tables are truncated):
# TEST_DATABASE_URL=postgresql://builderwars:builderwars-local@localhost:5432/builderwars_test

# --- Host runtime / simulator (device/, runs on the PC wired to the FREE-WILi) ---
DEVICE_ID=sim-001
DEVICE_HARDWARE_MODEL=freewili-1-og
DEVICE_FIRMWARE_VERSION=0.0.0-dev
DEVICE_TRANSPORT=stdout        # stdout | mqtt (awsiotsdk, install the "mqtt" extra)
DEVICE_SENSORS=simulated       # simulated | freewili (pip install freewili==0.0.51)
DEVICE_SAMPLE_INTERVAL_S=1
DEVICE_BATCH_WINDOW_S=5        # telemetry batch: every 5 s or 32 samples (decision #6)
DEVICE_HEARTBEAT_INTERVAL_S=30
BUILDERWARS_STATE_DIR=~/.builderwars   # persisted sequence numbers (decision #14)
# Only for DEVICE_TRANSPORT=mqtt against a dev AWS IoT endpoint. Paths only; keep the files
# outside the repository.
# IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.<region>.amazonaws.com
# IOT_PORT=8883
# IOT_CERT_PATH=~/.builderwars/credentials/device.pem.crt
# IOT_KEY_PATH=~/.builderwars/credentials/private.pem.key
# IOT_CA_PATH=~/.builderwars/credentials/AmazonRootCA1.pem

# --- AI provider (decision #8; client not implemented yet) ---
# AI_PROVIDER=bedrock            # bedrock (IAM/SigV4, no key) | openai_compatible
# AI_MODEL=                      # chosen in spec 08
# AI_REGION=us-east-1
# AI_BASE_URL=http://localhost:11434/v1   # openai_compatible only
# AI_API_KEY_SECRET_ID=          # Secrets Manager id; never the key itself
