# Copy to .env for local development. Placeholder values only; never put real secrets here.

# --- API (apps/api) ---
APP_ENV=local                  # local | test | dev | staging | prod
AUTH_MODE=dev-header           # dev-header (local/test only) | cognito (TODO)
REPOSITORY_BACKEND=memory      # memory (local/test only) | postgres (TODO)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- Future PostgreSQL adapter (docker compose --profile postgres) ---
# DATABASE_URL=postgresql://builderwars:builderwars-local@localhost:5432/builderwars

# --- Board runtime / simulator (device/) ---
DEVICE_ID=sim-001
DEVICE_HARDWARE_MODEL=simulated-board
DEVICE_FIRMWARE_VERSION=0.0.0-dev
DEVICE_TRANSPORT=stdout        # stdout | mqtt (stub, not implemented)
DEVICE_TELEMETRY_INTERVAL_S=5
DEVICE_HEARTBEAT_INTERVAL_S=30
# Only for DEVICE_TRANSPORT=mqtt against a dev AWS IoT endpoint. Paths only; keep the files
# outside the repository.
# IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.<region>.amazonaws.com
# IOT_PORT=8883
# IOT_CERT_PATH=/path/outside/repo/device.cert.pem
# IOT_KEY_PATH=/path/outside/repo/device.private.key
# IOT_CA_PATH=/path/outside/repo/AmazonRootCA1.pem
