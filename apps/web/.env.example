# Base URL of the API. "/api" uses the Vite dev proxy to http://localhost:8000.
VITE_API_BASE_URL=/api
# LOCAL ONLY: user id sent as X-Dev-User. Replaced by Cognito sign-in later.
VITE_DEV_USER=dev-user
# Realtime provider: "local" (the local API's event stream; default), "memory" (in-browser
# bus only) or "appsync" (AWS AppSync Events; needs Cognito sign-in, not wired yet).
VITE_REALTIME_PROVIDER=local
# Only for "appsync": the CDK outputs EventsHttpDns and EventsRealtimeDns.
VITE_APPSYNC_EVENTS_HTTP_DNS=
VITE_APPSYNC_EVENTS_REALTIME_DNS=
