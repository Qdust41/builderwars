# Base URL of the API. "/api" uses the Vite dev proxy to http://localhost:8000.
VITE_API_BASE_URL=/api
# Sign-in: "dev-header" (LOCAL ONLY; sends VITE_DEV_USER as X-Dev-User, API AUTH_MODE=dev-header)
# or "cognito" (email + password against the user pool, API AUTH_MODE=cognito).
VITE_AUTH_MODE=dev-header
VITE_DEV_USER=dev-user
# Only for "cognito": the CDK outputs UserPoolId and UserPoolClientId.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Realtime provider: "local" (the local API's event stream; default), "memory" (in-browser
# bus only) or "appsync" (AWS AppSync Events; needs VITE_AUTH_MODE=cognito).
VITE_REALTIME_PROVIDER=local
# Only for "appsync": the CDK outputs EventsHttpDns and EventsRealtimeDns.
VITE_APPSYNC_EVENTS_HTTP_DNS=
VITE_APPSYNC_EVENTS_REALTIME_DNS=
