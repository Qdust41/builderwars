{
  "name": "builderwars-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../../contracts/api/openapi.json -o src/api/schema.gen.ts",
    "check:api": "openapi-typescript ../../contracts/api/openapi.json -o node_modules/.cache/schema.gen.ts && node -e \"const fs=require('fs');if(fs.readFileSync('node_modules/.cache/schema.gen.ts','utf8')!==fs.readFileSync('src/api/schema.gen.ts','utf8')){console.error('src/api/schema.gen.ts is stale: run npm run gen:api');process.exit(1)}\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "aws-amplify": "6.22.2",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
